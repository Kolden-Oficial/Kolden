{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Design tokens do NutriOS Pro (DTCG). Identidade própria verde/teal, dark-first — NÃO usa a paleta da Kolden. Fonte única de verdade: tokens.css e tailwind.tokens.js derivam destes valores. Cores semânticas mapeadas para os mesmos nomes de var que o shadcn/ui usa.",
  "color": {
    "brand": {
      "deep-forest":  { "$type": "color", "$value": "#0D2320", "$description": "Primary Dark — fundo primário da UI escura. hsl(172 46% 9%)" },
      "dark-teal":    { "$type": "color", "$value": "#0F3D35", "$description": "Secondary Dark — superfícies/cards. hsl(170 61% 15%)" },
      "forest-green": { "$type": "color", "$value": "#0A5C52", "$description": "Brand Teal — bordas, divisores, fundos secundários. hsl(173 80% 20%)" },
      "aqua-green":   { "$type": "color", "$value": "#2BBFA0", "$description": "Mid tone — hover, estados intermediários, gráfico secundário. hsl(167 63% 46%)" },
      "neon-mint":    { "$type": "color", "$value": "#00E87A", "$description": "Brand Green — CTAs, foco, dado-chave. hsl(152 100% 45%). Texto SOBRE ele = preto." },
      "black":        { "$type": "color", "$value": "#000000", "$description": "Texto sobre Neon Mint/Aqua (claros); texto em superfície clara." },
      "white":        { "$type": "color", "$value": "#FFFFFF", "$description": "Texto/corpo sobre fundos escuros; dados clínicos." }
    },

    "_comment_dark": "Tema ESCURO = base canônica (dark-first). Os tokens semânticos abaixo são os do dark.",

    "background": { "$type": "color", "$value": "{color.brand.deep-forest}", "$description": "--background" },
    "foreground": { "$type": "color", "$value": "{color.brand.white}", "$description": "--foreground (16.43:1 sobre deep-forest)" },

    "card":       { "$type": "color", "$value": "{color.brand.dark-teal}", "$description": "--card / --popover" },
    "card-foreground": { "$type": "color", "$value": "{color.brand.white}", "$description": "--card-foreground" },

    "primary": {
      "default":    { "$type": "color", "$value": "{color.brand.neon-mint}", "$description": "--primary (CTA, foco, dado-chave)" },
      "foreground": { "$type": "color", "$value": "{color.brand.black}", "$description": "--primary-foreground — PRETO sobre mint (12.82:1). Nunca branco." }
    },
    "secondary": {
      "default":    { "$type": "color", "$value": "#15463C", "$description": "--secondary (chips/toggles). hsl(169 55% 18%)" },
      "foreground": { "$type": "color", "$value": "{color.brand.white}" }
    },
    "muted": {
      "default":    { "$type": "color", "$value": "#15332E", "$description": "--muted. hsl(172 40% 16%)" },
      "foreground": { "$type": "color", "$value": "#7FA39B", "$description": "--muted-foreground (5.96:1 sobre deep-forest — passa AA)" }
    },
    "accent": {
      "default":    { "$type": "color", "$value": "{color.brand.aqua-green}", "$description": "--accent (hover, gráfico secundário, estado)" },
      "foreground": { "$type": "color", "$value": "{color.brand.black}", "$description": "--accent-foreground — preto sobre aqua (9.06:1)" }
    },

    "success": {
      "default":    { "$type": "color", "$value": "{color.brand.neon-mint}", "$description": "--success (reusa mint — sucesso é a cor-marca)" },
      "foreground": { "$type": "color", "$value": "{color.brand.black}" }
    },
    "warning": {
      "default":    { "$type": "color", "$value": "#F2A13D", "$description": "--warning (âmbar — destoa do verde de propósito). hsl(38 92% 58%)" },
      "foreground": { "$type": "color", "$value": "{color.brand.black}" }
    },
    "destructive": {
      "default":    { "$type": "color", "$value": "#E8513F", "$description": "--destructive (vermelho — único quente; sinaliza erro). hsl(4 80% 58%)" },
      "foreground": { "$type": "color", "$value": "{color.brand.white}" }
    },

    "border": { "$type": "color", "$value": "{color.brand.forest-green}", "$description": "--border / --input. hsl(173 60% 18%)" },
    "ring":   { "$type": "color", "$value": "{color.brand.neon-mint}", "$description": "--ring (foco visível)" },

    "chart": {
      "1": { "$type": "color", "$value": "{color.brand.neon-mint}" },
      "2": { "$type": "color", "$value": "{color.brand.aqua-green}" },
      "3": { "$type": "color", "$value": "{color.brand.forest-green}" },
      "4": { "$type": "color", "$value": "{color.brand.dark-teal}" },
      "5": { "$type": "color", "$value": "#7FA39B", "$description": "Linha de base/grade dos gráficos" }
    }
  },

  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["Baloo 2", "system-ui", "sans-serif"], "$description": "Display/títulos — rounded-geométrica, ecoa o monograma. NUNCA em tabela de dados." },
      "base":    { "$type": "fontFamily", "$value": ["Inter", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"], "$description": "UI/corpo/dados clínicos. Ativar tabular-nums em colunas numéricas." },
      "mono":    { "$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "monospace"], "$description": "IDs técnicos/logs no admin (raro)." }
    },
    "feature": {
      "tabular-nums": { "$type": "string", "$value": "\"tnum\" 1", "$description": "font-feature-settings para alinhar colunas de kcal/g/%/medidas" }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "display": { "$type": "dimension", "$value": "3rem" },
      "h1":      { "$type": "dimension", "$value": "2.25rem" },
      "h2":      { "$type": "dimension", "$value": "1.875rem" },
      "h3":      { "$type": "dimension", "$value": "1.5rem" },
      "h4":      { "$type": "dimension", "$value": "1.25rem" },
      "body-lg": { "$type": "dimension", "$value": "1.0625rem" },
      "body":    { "$type": "dimension", "$value": "0.9375rem" },
      "small":   { "$type": "dimension", "$value": "0.8125rem" },
      "eyebrow": { "$type": "dimension", "$value": "0.75rem" }
    },
    "line-height": {
      "tight":  { "$type": "number", "$value": 1.15 },
      "snug":   { "$type": "number", "$value": 1.3 },
      "normal": { "$type": "number", "$value": 1.6 }
    }
  },

  "space": {
    "0":  { "$type": "dimension", "$value": "0rem" },
    "1":  { "$type": "dimension", "$value": "0.25rem" },
    "2":  { "$type": "dimension", "$value": "0.5rem" },
    "3":  { "$type": "dimension", "$value": "0.75rem" },
    "4":  { "$type": "dimension", "$value": "1rem" },
    "6":  { "$type": "dimension", "$value": "1.5rem" },
    "8":  { "$type": "dimension", "$value": "2rem" },
    "12": { "$type": "dimension", "$value": "3rem" },
    "16": { "$type": "dimension", "$value": "4rem" },
    "24": { "$type": "dimension", "$value": "6rem" }
  },

  "radius": {
    "sm":   { "$type": "dimension", "$value": "0.375rem" },
    "md":   { "$type": "dimension", "$value": "0.5rem" },
    "lg":   { "$type": "dimension", "$value": "0.75rem", "$description": "Base de --radius. Mais arredondado, ecoa o monograma rounded." },
    "pill": { "$type": "dimension", "$value": "9999px" }
  },

  "shadow": {
    "sm":   { "$type": "shadow", "$value": { "offsetX": "0", "offsetY": "1px",  "blur": "2px",  "spread": "0", "color": "rgba(0,0,0,0.45)" } },
    "md":   { "$type": "shadow", "$value": { "offsetX": "0", "offsetY": "4px",  "blur": "14px", "spread": "0", "color": "rgba(0,0,0,0.55)" } },
    "lg":   { "$type": "shadow", "$value": { "offsetX": "0", "offsetY": "12px", "blur": "32px", "spread": "0", "color": "rgba(0,0,0,0.6)" } },
    "glow": { "$type": "shadow", "$value": { "offsetX": "0", "offsetY": "0",    "blur": "24px", "spread": "0", "color": "rgba(0,232,122,0.30)" }, "$description": "Brilho Neon Mint para destaque clínico/tech" }
  },

  "gradient": {
    "primary": { "$type": "string", "$value": "linear-gradient(135deg, #0A5C52, #00E87A)", "$description": "Forest -> Mint (logo, header)" },
    "accent":  { "$type": "string", "$value": "linear-gradient(135deg, #2BBFA0, #00E87A)", "$description": "Aqua -> Mint (destaques)" },
    "hero":    { "$type": "string", "$value": "linear-gradient(135deg, #0D2320, #0A5C52)", "$description": "Deep Forest -> Forest (heros escuros)" },
    "water":   { "$type": "string", "$value": "linear-gradient(135deg, #0F3D35, #2BBFA0)", "$description": "Substitui o gradiente cyan/blue hardcoded do WaterTracker (P1 da auditoria)" }
  }
}
