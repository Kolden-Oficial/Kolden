generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  patient
  secretary
  doctor
}

enum PlantStage {
  seed
  sprout
  seedling
  adult
  tree
}

enum ScaleType {
  HAM_A @map("HAM-A")
  HAM_D @map("HAM-D")
  MADRS
  YMRS
  COCOCOLOS
}

enum EventType {
  appointment
  task
  milestone
  reminder
}

enum NotificationType {
  reminder
  message
  report
  scale
  milestone
  system
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id        String   @id @db.Uuid
  email     String
  role      UserRole
  name      String
  photoUrl  String?  @map("photo_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  patientProfile   PatientProfile?  @relation("UserProfile")
  doctorPatients   PatientProfile[] @relation("DoctorPatients")
  sentMessages     Message[]        @relation("SentMessages")
  receivedMessages Message[]        @relation("ReceivedMessages")
  reports          Report[]
  gamification     Gamification?
  calendarEvents   CalendarEvent[]
  notifications    Notification[]
  checkins         DailyCheckin[]
  scales           DiagnosticScale[]

  @@map("users")
}

model PatientProfile {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String    @unique @map("user_id") @db.Uuid
  doctorId              String?   @map("doctor_id") @db.Uuid
  diagnoses             Json      @default("[]")
  medications           Json      @default("[]")
  goals                 Json      @default("[]")
  notes                 String?
  onboardingCompletedAt DateTime? @map("onboarding_completed_at") @db.Timestamptz()
  reminderTime          String?   @map("reminder_time")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  user   User  @relation("UserProfile", fields: [userId], references: [id])
  doctor User? @relation("DoctorPatients", fields: [doctorId], references: [id])

  @@map("patient_profiles")
}

model MonitoringArea {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  icon        String
  description String?
  orderIndex  Int     @map("order_index")
  active      Boolean @default(true)

  checkins DailyCheckin[]

  @@map("monitoring_areas")
}

model DailyCheckin {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  areaId    String   @map("area_id") @db.Uuid
  date      DateTime @db.Date
  value     Int?
  notes     String?
  photoUrl  String?  @map("photo_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  patient User           @relation(fields: [patientId], references: [id])
  area    MonitoringArea @relation(fields: [areaId], references: [id])

  @@unique([patientId, areaId, date])
  @@map("daily_checkins")
}

model DiagnosticScale {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId       String    @map("patient_id") @db.Uuid
  scaleType       ScaleType @map("scale_type")
  responses       Json
  score           Int?
  filledAt        DateTime  @default(now()) @map("filled_at") @db.Timestamptz()
  appointmentDate DateTime? @map("appointment_date") @db.Date

  patient User @relation(fields: [patientId], references: [id])

  @@map("diagnostic_scales")
}

model Message {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  senderId      String    @map("sender_id") @db.Uuid
  receiverId    String    @map("receiver_id") @db.Uuid
  content       String?
  attachmentUrl String?   @map("attachment_url")
  readAt        DateTime? @map("read_at") @db.Timestamptz()
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@map("messages")
}

model Report {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId   String   @map("patient_id") @db.Uuid
  content     String
  attachments Json     @default("[]")
  sentAt      DateTime @default(now()) @map("sent_at") @db.Timestamptz()

  patient User @relation(fields: [patientId], references: [id])

  @@map("reports")
}

model Gamification {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId      String     @unique @map("patient_id") @db.Uuid
  streakDays     Int        @default(0) @map("streak_days")
  plantStage     PlantStage @default(seed) @map("plant_stage")
  lastActivityAt DateTime?  @map("last_activity_at") @db.Timestamptz()
  totalDays      Int        @default(0) @map("total_days")

  patient User @relation(fields: [patientId], references: [id])

  @@map("gamification")
}

model ImpactPhrase {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  disorderType String  @map("disorder_type")
  dayOfMonth   Int     @map("day_of_month")
  content      String
  author       String
  source       String?

  @@map("impact_phrases")
}

model Meditation {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  audioUrl        String   @map("audio_url")
  durationSeconds Int      @map("duration_seconds")
  category        String
  disorderTypes   Json     @default("[]") @map("disorder_types")
  active          Boolean  @default(true)

  @@map("meditations")
}

model CalendarEvent {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId    String    @map("patient_id") @db.Uuid
  title        String
  type         EventType
  eventDate    DateTime  @map("event_date") @db.Date
  notes        String?
  reminderSent Boolean   @default(false) @map("reminder_sent")

  patient User @relation(fields: [patientId], references: [id])

  @@map("calendar_events")
}

model Notification {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  type        NotificationType
  content     String
  read        Boolean          @default(false)
  scheduledAt DateTime?        @map("scheduled_at") @db.Timestamptz()
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}
