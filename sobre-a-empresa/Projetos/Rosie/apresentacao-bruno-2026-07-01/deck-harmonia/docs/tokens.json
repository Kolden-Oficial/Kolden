{
  "schema_version": "1.0.0",
  "design_system": "Rosie 360 Deck — Kolden × Rosie",
  "atualizado_em": "2026-06-30",
  "agente_responsavel": "design-system-architect",
  "metodologia": "3-tier token architecture: primitive → semantic → component",

  "tier_1_primitive": {
    "color": {
      "rose-50":  "#FBF5F8",
      "rose-100": "#F8E3E8",
      "rose-200": "#F2E2E9",
      "rose-300": "#E6D2DC",
      "rose-400": "#C9A8B7",
      "rose-500": "#A88496",
      "rose-600": "#7F6271",
      "ink-50":   "#F4F2F0",
      "ink-100": "#E8E6E2",
      "ink-200": "#BDBAB5",
      "ink-300": "#807A6F",
      "ink-400": "#403B33",
      "ink-500": "#14100C",
      "ink-600": "#0A0805",
      "white":   "#FFFFFF",
      "grey-50": "#FAFAFA",
      "grey-100": "#EBEBEB",
      "grey-200": "#D5D5D5",
      "grey-300": "#A0A0A0",
      "scarlet-400": "#FF6450",
      "scarlet-500": "#FF3D22",
      "scarlet-600": "#D62F15",
      "offwhite": "#E8E6F1"
    },
    "typography": {
      "font-marcellus": "'Marcellus', Georgia, 'Times New Roman', serif",
      "font-dm-sans":   "'DM Sans', system-ui, -apple-system, 'Segoe UI', sans-serif",
      "font-lato":      "'Lato', system-ui, sans-serif",
      "scale-100": "0.62rem",
      "scale-200": "0.75rem",
      "scale-300": "0.85rem",
      "scale-400": "0.95rem",
      "scale-500": "1.0rem",
      "scale-600": "1.25rem",
      "scale-700": "1.7rem",
      "scale-800": "2.5rem",
      "scale-900": "4.0rem",
      "scale-1000": "6.0rem"
    },
    "lineheight": {
      "tight": "1.1",
      "snug": "1.2",
      "normal": "1.3",
      "relaxed": "1.4",
      "loose": "1.55"
    },
    "spacing": {
      "space-50": "0.25rem",
      "space-100": "0.5rem",
      "space-200": "1.0rem",
      "space-300": "1.75rem",
      "space-400": "3.0rem",
      "space-500": "5.0rem"
    },
    "radius": {
      "none": "0",
      "sm": "2px",
      "md": "4px",
      "lg": "8px",
      "pill": "999px",
      "circle": "50%"
    },
    "shadow": {
      "none": "none",
      "sm": "0 1px 2px rgba(20,16,12,0.08)",
      "md": "0 4px 8px rgba(20,16,12,0.12)",
      "lg": "0 8px 24px rgba(20,16,12,0.16)",
      "elevated": "0 4px 16px rgba(20,16,12,0.2)"
    },
    "breakpoint": {
      "mobile":   "768px",
      "tablet":  "1024px",
      "desktop": "1440px"
    },
    "z-index": {
      "base": "0",
      "raised": "5",
      "overlay": "10",
      "modal": "100"
    },
    "letterspacing": {
      "tight": "-0.01em",
      "normal": "0",
      "wide": "0.08em",
      "wider": "0.12em",
      "widest": "0.18em"
    }
  },

  "tier_2_semantic": {
    "color-brand-primary":          "rose-300",
    "color-brand-primary-strong":   "rose-400",
    "color-brand-primary-subtle":   "rose-200",
    "color-brand-accent":           "scarlet-500",
    "color-brand-accent-hover":     "scarlet-400",
    "color-text-on-light":          "ink-500",
    "color-text-on-light-muted":    "ink-300",
    "color-text-on-dark":           "offwhite",
    "color-text-on-dark-muted":     "rose-200",
    "color-text-on-brand":          "ink-500",
    "color-text-emphasis":          "scarlet-500",
    "color-surface-default":        "white",
    "color-surface-elevated":       "rose-100",
    "color-surface-emphasis":       "rose-300",
    "color-surface-cover":          "ink-500",
    "color-surface-section":        "ink-500",
    "color-border-default":         "ink-100",
    "color-border-emphasis":        "scarlet-500",
    "color-border-subtle":          "ink-100",
    "color-focus-ring":             "scarlet-500",
    "color-funnel-tofu":            "rose-200",
    "color-funnel-mofu":            "rose-300",
    "color-funnel-bofu":            "rose-400",
    "color-funnel-cross":           "ink-500",
    "color-channel-paid":           "scarlet-500",
    "color-channel-organic":        "ink-500",
    "color-channel-email":          "rose-400",
    "color-channel-direct":         "#6b8e7f",

    "type-display":                 { "family": "font-marcellus", "size": "scale-1000", "lineheight": "tight", "letterspacing": "tight" },
    "type-h1":                      { "family": "font-marcellus", "size": "scale-900",  "lineheight": "tight", "letterspacing": "tight" },
    "type-h2":                      { "family": "font-marcellus", "size": "scale-800",  "lineheight": "snug" },
    "type-h3":                      { "family": "font-marcellus", "size": "scale-700",  "lineheight": "snug" },
    "type-body":                    { "family": "font-dm-sans",   "size": "scale-600",  "lineheight": "loose" },
    "type-small":                   { "family": "font-dm-sans",   "size": "scale-400",  "lineheight": "relaxed" },
    "type-micro":                   { "family": "font-dm-sans",   "size": "scale-200",  "lineheight": "normal" },
    "type-eyebrow":                 { "family": "font-lato",      "size": "scale-300",  "letterspacing": "widest", "uppercase": true, "weight": 700 },
    "type-data-large":              { "family": "font-marcellus", "size": "scale-900",  "lineheight": "tight" },

    "spacing-content-x":            "space-400",
    "spacing-content-y":            "space-400",
    "spacing-block":                "space-300",
    "spacing-inline":               "space-200",
    "spacing-tight":                "space-100",

    "radius-card":                  "none",
    "radius-pill":                  "pill",
    "radius-circle":                "circle",
    "radius-tag":                   "pill",

    "shadow-card":                  "sm",
    "shadow-elevated":              "elevated",

    "min-touch-target":             "44px"
  },

  "tier_3_component": {
    "card": {
      "background":                 "color-surface-default",
      "border":                     "1px solid color-border-default",
      "padding":                    "spacing-block",
      "radius":                     "radius-card"
    },
    "card-emphasis": {
      "background":                 "color-surface-elevated",
      "border":                     "1px solid color-brand-primary-strong",
      "padding":                    "spacing-block",
      "radius":                     "radius-card"
    },
    "kpi-number": {
      "typography":                 "type-data-large",
      "color":                      "color-text-on-light"
    },
    "kpi-number-inverted": {
      "typography":                 "type-data-large",
      "color":                      "color-brand-primary"
    },
    "kpi-label": {
      "typography":                 "type-eyebrow",
      "color":                      "color-text-on-light-muted"
    },
    "tag": {
      "padding-inline":             "0.7em",
      "padding-block":              "0.3em",
      "radius":                     "radius-pill",
      "typography":                 "type-eyebrow",
      "background-tofu":            "color-funnel-tofu",
      "background-mofu":            "color-funnel-mofu",
      "background-bofu":            "color-funnel-bofu"
    },
    "trace-tag": {
      "_omitted_in_harmonia":       "trace-tag é gate AIOX (Prometeu), não existe no Harmonia"
    },
    "focus-ring": {
      "outline":                    "2px solid color-focus-ring",
      "outline-offset":             "2px"
    },
    "funnel-node": {
      "background":                 "color-surface-default",
      "border":                     "1px solid color-border-default",
      "padding-inline":             "0.7em",
      "padding-block":              "0.5em",
      "radius":                     "radius-card",
      "border-left-paid":           "3px solid color-channel-paid",
      "border-left-organic":        "3px solid color-channel-organic",
      "border-left-email":          "3px solid color-channel-email",
      "border-left-direct":         "3px solid color-channel-direct"
    },
    "gantt-cell": {
      "background-l1":              "color-funnel-tofu",
      "background-l2":              "color-funnel-mofu",
      "background-l3":              "color-funnel-bofu",
      "background-l4":              "color-funnel-cross",
      "background-milestone":       "color-brand-accent",
      "min-height":                 "1.8em"
    },
    "table-row-tofu":               { "background": "rgba(248,227,232,0.35)" },
    "table-row-mofu":               { "background": "rgba(230,210,220,0.35)" },
    "table-row-bofu":               { "background": "rgba(201,168,183,0.35)" }
  },

  "responsive": {
    "viewport-mobile": {
      "spacing-content-x": "space-300",
      "spacing-content-y": "space-300",
      "grid-columns": 1
    },
    "viewport-tablet": {
      "grid-columns-card": 2
    },
    "viewport-desktop": {
      "grid-columns-card": 4
    }
  },

  "wcag_compliance": {
    "minimum_level": "AA",
    "contrast_audit": "ver wcag-audit.md — todos os pares testados",
    "min_touch_target_px": 44,
    "focus_visible_outline_px": 2,
    "color_blind_friendly": "validado para deuteranopia + protanopia (vermelho + preto + rosa têm contraste de luminância suficiente)"
  }
}
