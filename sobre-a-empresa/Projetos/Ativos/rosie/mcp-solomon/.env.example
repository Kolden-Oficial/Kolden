# MCP Íris — variáveis de ambiente (exemplo)
# NUNCA versionar valores reais. O padrão de produção é buscar tudo via Infisical.
#
# Modo Infisical (preferido em produção):
#   Instale o CLI do Infisical e rode:
#     infisical run -- node dist/index.js
#   O CLI injeta as variáveis abaixo automaticamente.
#
# Modo shim (opcional — quando o shim Node do Kolden já injeta segredos no ambiente):
#   Ver ~/.claude/infisical-shim.cjs (reference_mcp_infisical_sac_shim).
#
# Modo dev direto (LOCAL apenas — nunca commitar valores):
#   Copie este arquivo para `.env` e preencha manualmente para rodar o eval local.
#   `.env` está no .gitignore.

# Token Solomon — escopos orders.write + products.write
# Path Infisical: /kolden/prod/SOLOMON_TOKEN_API (live) ou /kolden/dev/SOLOMON_TOKEN_API (sandbox)
SOLOMON_TOKEN_API=

# Company ID Rosie (público, mas mantido no Infisical por consistência)
# Path Infisical: /kolden/prod/SOLOMON_COMPANY_ID_ROSIE
SOLOMON_COMPANY_ID_ROSIE=

# Ambiente Solomon — "live" ou "sandbox" (default: live)
SOLOMON_ENV=live

# Token Infisical (opcional — só quando o MCP fizer fetch REST direto ao Infisical)
# Ver skill infisical-padrao. Deixe vazio se o shim/CLI já injetar as variáveis acima.
INFISICAL_TOKEN=
INFISICAL_PROJECT_ID=
INFISICAL_ENV=prod
