{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Design tokens da Kolden (DTCG). Fonte única de verdade — tokens.css e tailwind.tokens.js derivam destes valores.",
  "color": {
    "brand": {
      "scarlet": { "$type": "color", "$value": "#FF3D22", "$description": "Cor-sinal primária" },
      "ink":     { "$type": "color", "$value": "#110E0F", "$description": "Base escura / fundo da marca" },
      "off-white": { "$type": "color", "$value": "#E8E6F1", "$description": "Claro de apoio (branco azulado)" },
      "white":   { "$type": "color", "$value": "#FFFFFF", "$description": "Branco puro" }
    },
    "neutral": {
      "ink-950": { "$type": "color", "$value": "#110E0F" },
      "ink-900": { "$type": "color", "$value": "#1A1617" },
      "ink-800": { "$type": "color", "$value": "#241F20" },
      "ink-700": { "$type": "color", "$value": "#332D2E" },
      "ink-500": { "$type": "color", "$value": "#6E6668" }
    },
    "bg": {
      "default": { "$type": "color", "$value": "{color.brand.ink}" },
      "surface": { "$type": "color", "$value": "{color.neutral.ink-900}" },
      "surface-2": { "$type": "color", "$value": "{color.neutral.ink-800}" },
      "inverse": { "$type": "color", "$value": "{color.brand.off-white}" }
    },
    "text": {
      "default": { "$type": "color", "$value": "{color.brand.off-white}" },
      "strong":  { "$type": "color", "$value": "{color.brand.white}" },
      "muted":   { "$type": "color", "$value": "{color.neutral.ink-500}" },
      "inverse": { "$type": "color", "$value": "{color.brand.ink}" },
      "accent":  { "$type": "color", "$value": "{color.brand.scarlet}" }
    },
    "accent": {
      "default":  { "$type": "color", "$value": "{color.brand.scarlet}" },
      "contrast": { "$type": "color", "$value": "{color.brand.ink}", "$description": "Texto sobre scarlet — ink passa AA (5.43:1); branco não" }
    },
    "border": {
      "default": { "$type": "color", "$value": "{color.neutral.ink-700}" },
      "focus":   { "$type": "color", "$value": "{color.brand.scarlet}" }
    }
  },
  "font": {
    "family": {
      "base":   { "$type": "fontFamily", "$value": ["Lato", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"] },
      "accent": { "$type": "fontFamily", "$value": ["Eurostile", "Saira Semi Condensed", "Rajdhani", "sans-serif"], "$description": "Apoio/detalhe — NUNCA em corpo de texto" }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 },
      "extrabold":{ "$type": "fontWeight", "$value": 800 },
      "black":    { "$type": "fontWeight", "$value": 900 }
    },
    "size": {
      "display": { "$type": "dimension", "$value": "3.815rem" },
      "h1":      { "$type": "dimension", "$value": "3.052rem" },
      "h2":      { "$type": "dimension", "$value": "2.441rem" },
      "h3":      { "$type": "dimension", "$value": "1.953rem" },
      "h4":      { "$type": "dimension", "$value": "1.563rem" },
      "body-lg": { "$type": "dimension", "$value": "1.25rem" },
      "body":    { "$type": "dimension", "$value": "1rem" },
      "small":   { "$type": "dimension", "$value": "0.8rem" },
      "eyebrow": { "$type": "dimension", "$value": "0.75rem" }
    },
    "line-height": {
      "tight":   { "$type": "number", "$value": 1.15 },
      "snug":    { "$type": "number", "$value": 1.3 },
      "normal":  { "$type": "number", "$value": 1.6 }
    }
  },
  "space": {
    "0":  { "$type": "dimension", "$value": "0rem" },
    "1":  { "$type": "dimension", "$value": "0.25rem" },
    "2":  { "$type": "dimension", "$value": "0.5rem" },
    "3":  { "$type": "dimension", "$value": "0.75rem" },
    "4":  { "$type": "dimension", "$value": "1rem" },
    "6":  { "$type": "dimension", "$value": "1.5rem" },
    "8":  { "$type": "dimension", "$value": "2rem" },
    "12": { "$type": "dimension", "$value": "3rem" },
    "16": { "$type": "dimension", "$value": "4rem" },
    "24": { "$type": "dimension", "$value": "6rem" }
  },
  "radius": {
    "sm":   { "$type": "dimension", "$value": "0.25rem" },
    "md":   { "$type": "dimension", "$value": "0.5rem" },
    "lg":   { "$type": "dimension", "$value": "1rem" },
    "pill": { "$type": "dimension", "$value": "9999px" }
  },
  "shadow": {
    "sm": { "$type": "shadow", "$value": { "offsetX": "0", "offsetY": "1px", "blur": "2px", "spread": "0", "color": "rgba(0,0,0,0.4)" } },
    "md": { "$type": "shadow", "$value": { "offsetX": "0", "offsetY": "4px", "blur": "12px", "spread": "0", "color": "rgba(0,0,0,0.5)" } },
    "glow": { "$type": "shadow", "$value": { "offsetX": "0", "offsetY": "0", "blur": "24px", "spread": "0", "color": "rgba(255,61,34,0.35)" }, "$description": "Brilho scarlet para destaques tech" }
  }
}
