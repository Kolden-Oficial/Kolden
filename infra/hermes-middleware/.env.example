# Autenticação — token compartilhado com Salesbot Kommo (widget_request header X-Kolden-Token)
# Rotacionar a cada 90d (Egide). Gerar via: openssl rand -hex 32
KOLDEN_TOKEN=troque-me-em-producao

# Porta HTTP (Railway sobrescreve com $PORT)
PORT=3000

# Fuso da Rosie (não muda — comércio BR)
ROSIE_TZ=America/Sao_Paulo

# Horário comercial (inteiros, 0-24)
BUSINESS_WEEKDAY_START=9
BUSINESS_WEEKDAY_END=18
BUSINESS_SATURDAY_START=9
BUSINESS_SATURDAY_END=13

# Textos de handoff — versão A (dentro do horário) e B (fora)
HANDOFF_TEXT_A=Uma consultora assume seu atendimento agora 💛
HANDOFF_TEXT_B=Já deixei tudo registrado aqui 💛 A gente não está em atendimento agora, mas assim que abrir uma consultora te responde por aqui — pode ficar tranquila.

# ─────────────────────────────────────────────────────────────────────
# Onda 3 — Scheduler + Chats API + Webhooks

# Kommo API (Rosie) — para chamar Chats API e mover cards
KOMMO_ROSIE_SUBDOMAIN=rosie
KOMMO_ROSIE_ACCESS_TOKEN=
KOMMO_ROSIE_ACCOUNT_ID=36679659
KOMMO_ROSIE_AMOJO_ID=141890a7-286c-4bf2-af0f-49f317014fba

# Chats API custom channel (registrado ao rodar bootstrap-chat-channel.ts)
# É o "scope_id" para enviar via https://amojo.kommo.com/v2/origin/custom/{scope_id}/...
KOMMO_ROSIE_CHANNEL_SCOPE_ID=
# Secret HMAC do canal (usado no header X-Signature)
KOMMO_ROSIE_CHANNEL_SECRET=

# Upstash Redis (fila de follow-ups)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Webhook secret compartilhado (Kommo → Hermes)
# Kommo webhook vem sem HMAC nativo — usar token na query string OU IP allowlist
KOMMO_WEBHOOK_SECRET=
